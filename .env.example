# Airtable: personal access token with data.records:read/write and schema.bases:read/write on your base
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_POSTS_TABLE=Posts
AIRTABLE_CHANNELS_TABLE=Channels

# Upload-Post API key (upload-post.com)
UPLOAD_POST_API_KEY=

# Optional: Slack incoming webhook for summaries and manual-post pings
SLACK_WEBHOOK_URL=

# Folder with strategy.md and channels/ (local path or a synced Drive folder)
STRATEGY_DIR=./my-strategy
